# dclaw environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Setup:
#   cp .env.example .env        # copy template
#   # fill in your keys below
#   source .env                 # load into current shell (add to ~/.zshrc or
#                               # ~/.bashrc to make permanent)
#
# .env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Choose your provider ───────────────────────────────────────────────────
# Uncomment exactly one line. dclaw uses this to pick which key/model to call.
#
export DEV_CLAW_PROVIDER=deepseek
# export DEV_CLAW_PROVIDER=openai
# export DEV_CLAW_PROVIDER=anthropic
# export DEV_CLAW_PROVIDER=groq
# export DEV_CLAW_PROVIDER=mistral
# export DEV_CLAW_PROVIDER=openrouter
# export DEV_CLAW_PROVIDER=sarvam
# export DEV_CLAW_PROVIDER=ollama       # local — no key needed, see section 3


# ── 2. API keys ───────────────────────────────────────────────────────────────
# Only the key matching your chosen provider above is required.
# The others can stay commented out.

# DeepSeek — https://platform.deepseek.com/api-keys
export DEEPSEEK_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
# export OPENAI_API_KEY=

# Anthropic / Claude — https://console.anthropic.com/settings/keys
# export ANTHROPIC_API_KEY=

# Groq (free tier available) — https://console.groq.com/keys
# export GROQ_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
# export MISTRAL_API_KEY=

# OpenRouter (routes to 200+ models) — https://openrouter.ai/settings/keys
# export OPENROUTER_API_KEY=

# Sarvam (Indian language models) — https://dashboard.sarvam.ai
# export SARVAM_API_KEY=


# ── 3. Ollama (local inference — no API key required) ─────────────────────────
# Install:  https://ollama.com  or  brew install ollama
# Start:    ollama serve
# Pull a model first, e.g.:
#   ollama pull llama3.2
#   ollama pull mistral
#   ollama pull codellama
#
# Then set DEV_CLAW_PROVIDER=ollama above and optionally override these:
# export OLLAMA_MODEL=llama3.2                        # default: llama3
# export OLLAMA_BASE_URL=http://localhost:11434/v1    # default shown


# ── 4. Cloud provider tokens (for dclaw cloud commands) ───────────────────────
# DigitalOcean — https://cloud.digitalocean.com/account/api/tokens
# export DIGITALOCEAN_TOKEN=

# Hetzner — https://console.hetzner.cloud → project → Security → API Tokens
# export HETZNER_API_TOKEN=


# ── 5. Credential vault (optional) ───────────────────────────────────────────
# dclaw can also store keys encrypted at ~/.dclaw/creds/ via:
#   dclaw config set-key --provider deepseek
# The vault requires a master passphrase each session. To avoid the prompt,
# set it here (less secure — only do this on a private dev machine):
# export DEV_CLAW_MASTER=
