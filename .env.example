# dclaw environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then load it in your shell:
#   source .env
# .env is gitignored — never commit real keys.

# ── Provider selection ────────────────────────────────────────────────────────
# Which LLM provider to use. Options: deepseek, openai, anthropic, claude,
# groq, mistral, openrouter, sarvam, ollama
export DEV_CLAW_PROVIDER=deepseek

# ── LLM API keys ─────────────────────────────────────────────────────────────
export DEEPSEEK_API_KEY=
# export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
# export GROQ_API_KEY=
# export MISTRAL_API_KEY=
# export OPENROUTER_API_KEY=
# export SARVAM_API_KEY=

# ── Ollama (local — no key required) ─────────────────────────────────────────
# export OLLAMA_BASE_URL=http://localhost:11434/v1
# export OLLAMA_MODEL=llama3.2

# ── Cloud provider tokens ─────────────────────────────────────────────────────
# export DIGITALOCEAN_TOKEN=
# export HETZNER_API_TOKEN=

# ── Credential vault ──────────────────────────────────────────────────────────
# Master passphrase for the encrypted key store (~/.dclaw/creds/).
# Set this to avoid being prompted interactively.
# export DEV_CLAW_MASTER=
