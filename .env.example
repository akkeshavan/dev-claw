# dclaw environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── Provider selection ────────────────────────────────────────────────────────
# Which LLM provider to use. Options: deepseek, openai, anthropic, claude,
# groq, mistral, openrouter, sarvam, ollama
DEV_CLAW_PROVIDER=deepseek

# ── LLM API keys ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# ── Ollama (local — no key required) ─────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# ── Cloud provider tokens ─────────────────────────────────────────────────────
# DIGITALOCEAN_TOKEN=
# HETZNER_API_TOKEN=

# ── Credential vault ──────────────────────────────────────────────────────────
# Master passphrase for the encrypted key store (~/.dclaw/creds/).
# Set this to avoid being prompted interactively.
# DEV_CLAW_MASTER=
